<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hotel Booking System"
        android:textSize="35sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Name Label & EditText -->
    <TextView
        android:id="@+id/tvNameLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Name"
        android:textSize="25sp" />

    <EditText
        android:id="@+id/etCustomerName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Type your name"
        android:inputType="textPersonName"
        android:layout_marginBottom="8dp" />

    <!-- Mobile Number Label & EditText -->
    <TextView
        android:id="@+id/tvMobileLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mobile Number"
        android:textSize="25sp" />

    <EditText
        android:id="@+id/etMobileNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Type your phone number"
        android:inputType="phone"
        android:layout_marginBottom="8dp" />

    <!-- NRC Number Label & EditText -->
    <TextView
        android:id="@+id/tvNrcLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NRC Number"
        android:textSize="25sp" />

    <EditText
        android:id="@+id/etNrcNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Type your NRC number"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <!-- Choose Room Type Section -->
    <TextView
        android:id="@+id/tvRoomTypeLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose Room Type"
        android:textSize="25sp" />

    <RadioGroup
        android:id="@+id/rgRoomType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <RadioButton
            android:id="@+id/rbSingleRoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Single Room"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rbDoubleRoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Double Room" />

        <RadioButton
            android:id="@+id/rbFamilyRoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Family Room" />
    </RadioGroup>

    <!-- Choose Floor Section -->
    <TextView
        android:id="@+id/tvFloorLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose Floor"
        android:textSize="25sp" />

    <CheckBox
        android:id="@+id/cbGroundFloor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ground Floor" />

    <CheckBox
        android:id="@+id/cbFirstFloor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="First Floor" />

    <CheckBox
        android:id="@+id/cbThirdFloor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Third Floor"
        android:layout_marginBottom="16dp" />

    <!-- Horizontal Linear Layout for Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBooking"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Booking" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Clear" />
    </LinearLayout>

</LinearLayout>